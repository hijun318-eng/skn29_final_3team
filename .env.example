# Compose project
COMPOSE_PROJECT_NAME=answervice

# Application PostgreSQL
APP_DB_NAME=app_db
APP_ADMIN_USER=app_admin
APP_ADMIN_PASSWORD=REQUIRED
APP_MIGRATION_USER=app_migration
APP_MIGRATION_PASSWORD=REQUIRED
APP_DB_USER=app_user
APP_DB_PASSWORD=REQUIRED
APP_DATABASE_URL=postgresql+psycopg://app_migration:REQUIRED@app-postgres:5432/app_db

# PMS PostgreSQL
PMS_DB_NAME=pms_db
PMS_ADMIN_USER=pms_admin
PMS_ADMIN_PASSWORD=REQUIRED
PMS_READONLY_USER=pms_reader
PMS_READONLY_PASSWORD=REQUIRED

# Banquet PostgreSQL
BANQUET_DB_NAME=banquet_db
BANQUET_ADMIN_USER=banquet_admin
BANQUET_ADMIN_PASSWORD=REQUIRED
BANQUET_READONLY_USER=banquet_reader
BANQUET_READONLY_PASSWORD=REQUIRED

# POS MySQL
POS_DB_NAME=pos_db
POS_ROOT_PASSWORD=REQUIRED
POS_READONLY_USER=pos_reader
POS_READONLY_PASSWORD=REQUIRED

# CRM SQL Server
CRM_DB_NAME=crm_db
CRM_SA_PASSWORD=REQUIRED
CRM_READONLY_USER=crm_reader
CRM_READONLY_PASSWORD=REQUIRED

# Facility ClickHouse
FACILITY_DB_NAME=facility
FACILITY_ADMIN_USER=facility_admin
FACILITY_ADMIN_PASSWORD=REQUIRED
FACILITY_READONLY_USER=facility_reader
FACILITY_READONLY_PASSWORD=REQUIRED

# Trino
TRINO_PORT=18080

# DataHub Core: approved release for the pinned R2 consumer fragment.
DATAHUB_VERSION=v1.7.0
DATAHUB_MAPPED_GMS_PORT=18081
DATAHUB_MAPPED_GMS_MANAGEMENT_PORT=14319
DATAHUB_MAPPED_FRONTEND_PORT=19002
DATAHUB_TOKEN_SERVICE_SALT=REQUIRED
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=REQUIRED
DATAHUB_SECRET=REQUIRED
DATAHUB_MYSQL_PASSWORD=REQUIRED
DATAHUB_MYSQL_ROOT_PASSWORD=REQUIRED
