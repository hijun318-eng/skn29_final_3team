#!/bin/sh

set -u

branch=$(git branch --show-current 2>/dev/null || printf '')
[ "$branch" = test ] || exit 0

enabled=$(git config --bool --get answervice.testAutoRefresh 2>/dev/null || printf 'false')
if [ "$enabled" != true ]; then
    printf '%s\n' '[post-merge] test runtime auto-refresh is disabled. Enable with: git config --local answervice.testAutoRefresh true'
    exit 0
fi

if ! command -v pwsh >/dev/null 2>&1; then
    printf '%s\n' '[post-merge] pwsh is required for test runtime refresh.' >&2
    exit 1
fi

pwsh -NoProfile -File .github/scripts/refresh_test_runtime.ps1
