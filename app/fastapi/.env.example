# Database (현재 SQLite 기본, PostgreSQL 전환 시 설정)
# DATABASE_URL=postgresql://senseplace_ro:senseplace_ro@localhost:5432/senseplace

# LLM Provider: stub | ollama | openai
SENSEPLACE_LLM_PROVIDER=stub

# Ollama (로컬 LLM) — provider=ollama 시 사용
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:4b

# OpenAI 호환 API (외부 LLM) — provider=openai 시 사용
# OpenAI, RunPod vLLM Serverless, 로컬 vLLM 모두 동일 인터페이스
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

INTERNAL_API_KEY=
DJANGO_API_URL=http://localhost:8000
