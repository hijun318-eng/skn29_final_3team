{
  "contract_version": "SERVER-ACCESS-PROFILES-v1.0.0",
  "default_effect": "deny",
  "all_users_policy_dependency": false,
  "datahub": {
    "authentication_required": true,
    "authorization_required": true,
    "view_authorization_required": true,
    "rest_api_authorization_required": true,
    "policy_privileges": [
      "VIEW_ENTITY"
    ],
    "policy_provisioning": "explicit_actor_domain_grants",
    "oss_search_visibility": "application_domain_filter_required"
  },
  "database_domains": {
    "pms": "urn:li:domain:rooms",
    "crm": "urn:li:domain:membership",
    "pos": "urn:li:domain:food_and_beverage",
    "facility": "urn:li:domain:facility",
    "banquet": "urn:li:domain:banquet"
  },
  "profiles": {
    "pms_only": {
      "database_grants": ["pms"],
      "datahub_actor": "urn:li:corpuser:answervice_pms_only",
      "datahub_token_env": "DATAHUB_PMS_ONLY_TOKEN",
      "trino_principal": "answervice_pms_only"
    },
    "crm_only": {
      "database_grants": ["crm"],
      "datahub_actor": "urn:li:corpuser:answervice_crm_only",
      "datahub_token_env": "DATAHUB_CRM_ONLY_TOKEN",
      "trino_principal": "answervice_crm_only"
    },
    "pms_crm": {
      "database_grants": ["pms", "crm"],
      "datahub_actor": "urn:li:corpuser:answervice_pms_crm",
      "datahub_token_env": "DATAHUB_PMS_CRM_TOKEN",
      "trino_principal": "answervice_pms_crm"
    },
    "integrated_revenue": {
      "database_grants": ["pms", "crm", "pos"],
      "datahub_actor": "urn:li:corpuser:answervice_integrated_revenue",
      "datahub_token_env": "DATAHUB_INTEGRATED_REVENUE_TOKEN",
      "trino_principal": "answervice_integrated_revenue"
    },
    "integrated_operations": {
      "database_grants": ["pms", "crm", "pos", "facility", "banquet"],
      "datahub_actor": "urn:li:corpuser:answervice_integrated_operations",
      "datahub_token_env": "DATAHUB_INTEGRATED_OPERATIONS_TOKEN",
      "trino_principal": "answervice_integrated_operations"
    }
  }
}
