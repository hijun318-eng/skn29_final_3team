# 책임: 필요한 deployment 변수의 이름과 안전하지 않은 placeholder만 문서화한다.
# 이 파일은 credential source가 아니며 CHANGE_ME_/REQUIRED_ 값으로 기동하면 실패해야 한다.
COMPOSE_PROJECT_NAME=answervice
APP_DB_NAME=app_db
APP_ADMIN_USER=app_admin
APP_ADMIN_PASSWORD=CHANGE_ME_AppAdmin
APP_MIGRATION_USER=app_migration
APP_MIGRATION_PASSWORD=CHANGE_ME_AppMigration
APP_CATALOG_PUBLISHER_USER=app_catalog_publisher
APP_CATALOG_PUBLISHER_PASSWORD=CHANGE_ME_AppCatalogPublisher
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_AppUser
PMS_DB_NAME=pms_db
PMS_ADMIN_USER=pms_admin
PMS_ADMIN_PASSWORD=CHANGE_ME_PmsAdmin
PMS_READONLY_USER=pms_reader
PMS_READONLY_PASSWORD=CHANGE_ME_PmsReader
BANQUET_DB_NAME=banquet_db
BANQUET_ADMIN_USER=banquet_admin
BANQUET_ADMIN_PASSWORD=CHANGE_ME_BanquetAdmin
BANQUET_READONLY_USER=banquet_reader
BANQUET_READONLY_PASSWORD=CHANGE_ME_BanquetReader
POS_DB_NAME=pos_db
POS_ROOT_PASSWORD=CHANGE_ME_PosRoot
POS_READONLY_USER=pos_reader
POS_READONLY_PASSWORD=CHANGE_ME_PosReader
CRM_DB_NAME=crm_db
CRM_SA_PASSWORD=CHANGE_ME_CrmSa
CRM_READONLY_USER=crm_reader
CRM_READONLY_PASSWORD=CHANGE_ME_CrmReader
FACILITY_DB_NAME=facility
FACILITY_ADMIN_USER=facility_admin
FACILITY_ADMIN_PASSWORD=CHANGE_ME_FacilityAdmin
FACILITY_READONLY_USER=facility_reader
FACILITY_READONLY_PASSWORD=CHANGE_ME_FacilityReader
TRINO_PORT=18443
TRINO_ADMIN_USER=answervice_platform_admin
TRINO_ADMIN_PASSWORD=CHANGE_ME_TrinoAdmin
TRINO_RUNTIME_USER=answervice_runtime
TRINO_RUNTIME_PASSWORD=CHANGE_ME_TrinoRuntime
TRINO_DATAHUB_USER=datahub_ingestion
TRINO_DATAHUB_PASSWORD=CHANGE_ME_TrinoDataHub
TRINO_INTERNAL_SHARED_SECRET=CHANGE_ME_TrinoInternalSharedSecret
TRINO_TLS_KEYSTORE_PASSWORD=CHANGE_ME_TrinoKeyStore
TRINO_PASSWORD_DB_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_TRINO_PASSWORD_DB_FILE
TRINO_TLS_KEYSTORE_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_TRINO_KEYSTORE_FILE
TRINO_TLS_CA_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_TRINO_CA_FILE
# 영속 serving shadow catalog. 운영에서는 env와 bootstrap credential file을 모두
# repository 밖 secret 경로에 두고 security/provision-serving-catalog-secrets.ps1로 생성한다.
SERVING_CATALOG_DB_NAME=serving_catalog
SERVING_CATALOG_DB_USER=serving_catalog
SERVING_CATALOG_DB_PASSWORD=CHANGE_ME_ServingCatalogDatabase
SERVING_CATALOG_ADMIN_CLIENT_ID=answervice_catalog_admin
SERVING_CATALOG_ADMIN_CLIENT_SECRET=CHANGE_ME_ServingCatalogAdminClient
SERVING_CATALOG_TRINO_PRINCIPAL=answervice_trino
SERVING_CATALOG_TRINO_CLIENT_ID=REQUIRED_PROVISION_BY_POLARIS
SERVING_CATALOG_TRINO_CLIENT_SECRET=REQUIRED_PROVISION_BY_POLARIS
SERVING_CATALOG_BOOTSTRAP_CREDENTIALS_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_SERVING_CATALOG_BOOTSTRAP_FILE
SERVING_CATALOG_TOKEN_PUBLIC_KEY_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_SERVING_CATALOG_TOKEN_PUBLIC_KEY
SERVING_CATALOG_TOKEN_PRIVATE_KEY_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_SERVING_CATALOG_TOKEN_PRIVATE_KEY
SERVING_CATALOG_API_PORT=18181
SERVING_OBJECT_STORE_ACCESS_KEY=CHANGE_ME_ServingObjectStoreAccess
SERVING_OBJECT_STORE_SECRET_KEY=CHANGE_ME_ServingObjectStoreSecret
SERVING_OBJECT_STORE_BUCKET=answervice-serving
SERVING_OBJECT_STORE_REGION=ap-northeast-2
DATAHUB_MAPPED_GMS_PORT=18081
DATAHUB_MAPPED_GMS_MANAGEMENT_PORT=14319
DATAHUB_MAPPED_FRONTEND_PORT=19002
DATAHUB_GMS_URL=https://127.0.0.1:18081
# DataHub Core v1.7 service account tokens are provisioned only after the core
# stage is reachable. Reader and publisher must be distinct actors and tokens.
DATAHUB_READ_ACTOR_URN=urn:li:corpuser:service_CHANGE_ME_read
DATAHUB_READ_API_TOKEN=CHANGE_ME_DataHubReadApiToken
DATAHUB_CATALOG_TTL_SECONDS=86400
RELEASE_READINESS_CACHE_TTL_SECONDS=86400
DATAHUB_PUBLISH_ACTOR_URN=urn:li:corpuser:service_CHANGE_ME_publish
DATAHUB_PUBLISH_API_TOKEN=CHANGE_ME_DataHubPublishApiToken
DATAHUB_SYSTEM_CLIENT_ID=__datahub_system
DATAHUB_SYSTEM_CLIENT_SECRET=CHANGE_ME_DataHubSystemClientSecret
DATAHUB_TLS_KEYSTORE_PASSWORD=CHANGE_ME_DataHubKeyStore
DATAHUB_TLS_TRUSTSTORE_PASSWORD=CHANGE_ME_DataHubTrustStore
DATAHUB_TLS_KEYSTORE_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_DATAHUB_KEYSTORE_FILE
DATAHUB_TLS_TRUSTSTORE_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_DATAHUB_TRUSTSTORE_FILE
DATAHUB_TLS_CA_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_DATAHUB_CA_FILE
# Catalog scope is an operator-owned runtime selection. Do not replace these
# values with application defaults or a release-specific table allowlist.
PMS_DATAHUB_SCHEMA=CHANGE_ME_CurrentPmsSchema
BANQUET_DATAHUB_SCHEMA=CHANGE_ME_CurrentBanquetSchema
POS_DATAHUB_DATABASE=CHANGE_ME_CurrentPosDatabase
CRM_DATAHUB_SCHEMA=CHANGE_ME_CurrentCrmSchema
FACILITY_DATAHUB_DATABASE=CHANGE_ME_CurrentFacilityDatabase
DATAHUB_SEMANTIC_ES_PORT=19200
DATAHUB_SEMANTIC_OLLAMA_PORT=11434
DATAHUB_SEMANTIC_ES_JAVA_OPTS="-Xms1g -Xmx1g"
DATAHUB_SEMANTIC_REINDEX_MAPPINGS=true
DATAHUB_SEMANTIC_REINDEX_SETTINGS=true
DATAHUB_SEMANTIC_CONVERGENCE_SECONDS=180
DATAHUB_SEMANTIC_MAX_DATASETS=10000
DATAHUB_SEMANTIC_MAX_CHUNKS=50000
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_MODEL_DIGEST=sha256:0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
DATAHUB_TOKEN_SERVICE_SALT=CHANGE_ME_DataHubTokenServiceSalt
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=CHANGE_ME_DataHubTokenServiceSigningKey
DATAHUB_SECRET_SERVICE_ENCRYPTION_KEY=CHANGE_ME_DataHubSecretServiceEncryptionKey
DATAHUB_SECRET=CHANGE_ME_DataHubSecret
DATAHUB_MYSQL_PASSWORD=CHANGE_ME_DataHubMysqlPassword
DATAHUB_MYSQL_ROOT_PASSWORD=CHANGE_ME_DataHubMysqlRootPassword
# Supply an absolute path outside this repository. The deployment fails closed
# until the operator mounts a provisioned secret file.
# CI can expand this absolute non-secret sentinel, while start.ps1 still rejects
# it because no local file exists. Provisioning replaces it with an operator-owned
# absolute host path outside the repository.
AUTH_PRINCIPALS_HOST_FILE=/run/secrets/REQUIRED_EXTERNAL_PRINCIPAL_FILE
AUTH_SESSION_SECRET=CHANGE_ME_AtLeast32Characters
AUTH_SESSION_TTL_SECONDS=86400
ANALYST_LOGIN_ID=analyst
ANALYST_LOGIN_PASSWORD=CHANGE_ME_AnalystPassword
ANALYST_LOGIN_ROLE=analyst
REPORT_ADMIN_LOGIN_ID=admin
REPORT_ADMIN_LOGIN_PASSWORD=CHANGE_ME_ReportAdminPassword
VITE_BACKEND_BASE_URL=/api
FRONTEND_BIND_ADDRESS=127.0.0.1
OPENAI_ENDPOINT=https://api.openai.com
OPENAI_API_KEY=CHANGE_ME_OpenAIApiKey
OPENAI_MODEL=gpt-5.4-mini
# RAG 공유 profile은 예제 sentinel로만 Compose를 전개하며 실제 배포에서는
# repository 밖에서 DB password와 32자 이상의 HMAC secret을 주입한다.
RAG_DB_PASSWORD=CHANGE_ME_RagDatabasePassword
RAG_GATEWAY_HMAC_SECRET=CHANGE_ME_RagGatewayHmacSecret_AtLeast32Characters
RAG_API_URL=http://rag-api:8000
RAG_TOOL_TIMEOUT_SECONDS=30
RAG_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
RAG_FEATURE_ENABLED=0
# synthetic CONDITIONAL_PASS ML candidate는 명시적 승인 전 기본 실행하지 않는다.
ML_RUNTIME_URL=http://ml-runtime:8000
ML_RUNTIME_TIMEOUT_SECONDS=90
ML_RUNTIME_HMAC_SECRET=CHANGE_ME_MlRuntimeHmacSecret_AtLeast32Characters
ML_APPROVED_MODEL_VERSION=room-demand-timeseries-hgbr-v2.2.0
ML_APPROVED_MODEL_SHA256=5b0a8a896bf87dd2516129d52599bf183c05dd7bc154e17b570851ca1e1564fa
ML_APPROVED_FEATURE_CONTRACT_SHA256=09089d55a6a330f54bd67548a5c6ce656d7b12948be18f5971bd4b7c12b44c79
ML_HISTORY_TABLE=pms.ml_evaluation.room_demand_daily_facts_20260826_v2
ML_FEATURE_ENABLED=0
ML_ALLOW_CONDITIONAL=false
# 원본 command admission과 Agent capability 재검증을 유지한 외부 Supervisor를 명시적으로 연다.
SUPERVISOR_FEATURE_ENABLED=0
SUPERVISOR_OPENAI_MODEL=gpt-5.6-terra
SUPERVISOR_REASONING_EFFORT=low
SUPERVISOR_TIMEOUT_SECONDS=15
# 네 값이 모두 비면 primary model 설정을 공유한다. 전용 Node2를 사용하면
# provider·endpoint·token·model 네 값을 모두 외부 배포 환경에서 제공해야 한다.
NODE2_MODEL_PROVIDER=
NODE2_MODEL_ENDPOINT=
NODE2_MODEL_API_TOKEN=
NODE2_MODEL=
MODEL_TIMEOUT_SECONDS=60
# hybrid: Compiler 미지원 구조를 Node2가 보완, compiler_only: 승인 Template·Compiler만 허용
ANALYSIS_SQL_GENERATION_MODE=hybrid
REPORT_ASSISTANT_MAX_MODEL_ATTEMPTS=2
REPORT_ASSISTANT_MAX_INPUT_TOKENS=16000
REPORT_ASSISTANT_MAX_OUTPUT_TOKENS=4096
REPORT_ASSISTANT_MAX_ESTIMATED_COST_USD=
REPORT_ASSISTANT_REQUESTS_PER_HOUR=30
# 비용 단가와 상한은 provider 계약에 따라 외부 환경에서 모두 명시한다.
# 하나라도 비어 있으면 외부 모델 transport 전에 fail-closed한다.
REPORT_ASSISTANT_INPUT_USD_PER_MILLION=
REPORT_ASSISTANT_OUTPUT_USD_PER_MILLION=
REPORT_ASSISTANT_EXTERNAL_TRANSFER_PREAUTHORIZED=false
MCP_TOOL_RATE_LIMIT_QUOTA=30
MCP_TOOL_RATE_LIMIT_WINDOW_SECONDS=60
READINESS_PROBE_TIMEOUT_SECONDS=2
