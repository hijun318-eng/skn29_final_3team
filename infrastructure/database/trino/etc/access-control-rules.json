{
  "catalogs": [
    {"user": "answervice_platform_admin", "catalog": "serving", "allow": "all"},
    {"user": "answervice_platform_admin", "catalog": "(pms|pos|crm|facility|banquet)", "allow": "all"},
    {"user": "datahub_ingestion", "catalog": "system", "allow": "read-only"},
    {"user": "datahub_ingestion", "catalog": "(serving|pms|pos|crm|facility|banquet)", "allow": "read-only"},
    {"user": "answervice_runtime", "catalog": "(serving|pms|pos|crm|facility|banquet)", "allow": "read-only"},
    {"catalog": "system", "allow": "none"},
    {"catalog": ".*", "allow": "none"}
  ],
  "schemas": [
    {"user": "answervice_platform_admin", "catalog": "serving", "schema": ".*", "owner": true},
    {"owner": false}
  ],
  "tables": [
    {
      "user": "datahub_ingestion",
      "catalog": "system",
      "schema": "metadata",
      "table": "(catalogs|table_comments)",
      "privileges": ["SELECT"]
    },
    {
      "user": "datahub_ingestion",
      "catalog": "system",
      "schema": ".*",
      "table": ".*",
      "privileges": []
    },
    {
      "user": "answervice_platform_admin",
      "catalog": "serving",
      "schema": ".*",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP", "GRANT_SELECT"]
    },
    {
      "user": "answervice_platform_admin",
      "catalog": "(pms|pos|crm|facility|banquet)",
      "schema": ".*",
      "table": ".*",
      "privileges": ["SELECT", "GRANT_SELECT"]
    },
    {
      "catalog": "(pms|pos|crm|facility|banquet)",
      "schema": "system",
      "table": ".*",
      "privileges": []
    },
    {
      "user": "datahub_ingestion",
      "catalog": "(serving|pms|pos|crm|facility|banquet)",
      "schema": ".*",
      "table": ".*",
      "privileges": ["SELECT"]
    },
    {
      "user": "answervice_runtime",
      "catalog": "(serving|pms|pos|crm|facility|banquet)",
      "schema": ".*",
      "table": ".*",
      "privileges": ["SELECT"]
    },
    {"privileges": []}
  ],
  "procedures": [
    {"privileges": []}
  ],
  "queries": [
    {"user": "answervice_platform_admin", "allow": ["execute", "view", "kill"]},
    {"user": "datahub_ingestion", "allow": ["execute"]},
    {"user": "answervice_runtime", "allow": ["execute"]},
    {"allow": []}
  ],
  "system_information": [
    {"user": "answervice_platform_admin", "allow": ["read"]},
    {"allow": []}
  ]
}
