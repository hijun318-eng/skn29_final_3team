  "metrics": [
    {"id": "rooms_sold", "unit": "room_night", "aggregation": "sum", "time_grain": "day", "source": "pms.stays"},
    {"id": "available_room_nights", "unit": "room_night", "aggregation": "sum", "time_grain": "day", "source": "pms.room_inventory_daily"},
    {"id": "occupancy_rate", "unit": "ratio", "formula": "rooms_sold / available_room_nights", "time_grain": "day", "source": "serving.hotel_daily_metrics"},
    {"id": "recognized_room_revenue", "unit": "KRW", "aggregation": "sum", "time_grain": "checkout_day", "source": "pms.stays.room_revenue"},
    {"id": "adr", "unit": "KRW_per_room_night", "formula": "stay_day_allocated_room_revenue / rooms_sold", "time_grain": "day", "source": "serving.hotel_daily_metrics"},
    {"id": "revpar", "unit": "KRW_per_available_room", "formula": "stay_day_allocated_room_revenue / available_room_nights", "time_grain": "day", "source": "serving.hotel_daily_metrics"},
    {"id": "reservation_cancellation_rate", "unit": "ratio", "formula": "cancelled_reservations / reservations", "time_grain": "booking_day", "source": "pms.reservations"},
    {"id": "fnb_net_revenue", "unit": "KRW", "aggregation": "sum", "time_grain": "day", "source": "pos.orders.net_amount"},
    {"id": "fnb_covers", "unit": "person", "aggregation": "sum", "time_grain": "day", "source": "pos.orders.guest_count"},
    {"id": "average_check", "unit": "KRW_per_cover", "formula": "fnb_net_revenue / fnb_covers", "time_grain": "day", "source": "serving.fnb_daily_metrics"},
    {"id": "revpash", "unit": "KRW_per_seat_hour", "formula": "fnb_net_revenue / available_seat_hours", "time_grain": "day", "source": "serving.fnb_daily_metrics"},
    {"id": "points_earned", "unit": "point", "aggregation": "sum_positive", "time_grain": "event_day", "source": "crm.point_transactions"},
    {"id": "points_used", "unit": "point", "aggregation": "sum_absolute_negative", "time_grain": "event_day", "source": "crm.point_transactions"},
    {"id": "points_expired", "unit": "point", "aggregation": "sum_absolute_negative", "time_grain": "event_day", "source": "crm.point_transactions"},
    {"id": "banquet_conversion_rate", "unit": "ratio", "formula": "confirmed_or_completed_bookings / inquiries", "time_grain": "inquiry_month", "source": "banquet.bookings"},
    {"id": "banquet_recognized_revenue", "unit": "KRW", "aggregation": "sum", "time_grain": "recognized_day", "source": "banquet.revenue_lines.recognized_amount"},
    {"id": "banquet_actual_attendees", "unit": "person", "aggregation": "sum", "time_grain": "event_day", "source": "banquet.bookings.actual_attendees"},
    {"id": "room_block_pickup_rate", "unit": "ratio", "formula": "pickup_room_nights / reserved_room_nights", "time_grain": "event_day", "source": "banquet.room_blocks"},
    {"id": "facility_usage_count", "unit": "event", "aggregation": "count", "time_grain": "day", "source": "facility.usage_events"},
    {"id": "facility_net_revenue", "unit": "KRW", "aggregation": "sum", "time_grain": "day", "source": "facility.usage_events.net_amount"},
    {"id": "facility_downtime_minutes", "unit": "minute", "aggregation": "sum", "time_grain": "day", "source": "facility.incidents"},
    {"id": "energy_per_occupied_room", "unit": "kWh_per_room_night", "formula": "energy_kwh / occupied_room_nights", "time_grain": "day", "source": "facility.resource_daily"},
    {"id": "total_operating_revenue", "unit": "KRW", "formula": "preaggregated_room + fnb + banquet + facility revenue", "time_grain": "day", "source": "serving.total_operating_daily_metrics"}
  ],
  "approved_joins": [
    {
      "id": "pms_stay_day_to_member_event_time_v2",
      "left": "pms.stays",
      "right": "crm.customer_map",
      "keys": ["guest_id = pms_guest_id"],
      "temporal_predicate": "valid_from <= stay_business_date AND (valid_to IS NULL OR stay_business_date < valid_to)",
      "cardinality": "many_to_zero_or_one",
      "rule": "투숙을 체크인 포함·체크아웃 미포함 stay-day로 확장하고 객실 매출을 박일 배분한 뒤 event-time identity map을 적용한다."
    },
    {
      "id": "pos_order_to_member_event_time_v2",
      "left": "pos.orders",
      "right": "crm.customer_map",
      "keys": ["pos_customer_ref = pos_customer_ref"],
      "temporal_predicate": "valid_from <= ordered_at AND (valid_to IS NULL OR ordered_at < valid_to)",
      "cardinality": "many_to_zero_or_one"
    },
    {
      "id": "facility_usage_to_member_event_time_v2",
      "left": "facility.usage_events",
      "right": "crm.customer_map",
      "keys": ["facility_user_ref = facility_user_ref"],
      "temporal_predicate": "valid_from <= event_at AND (valid_to IS NULL OR event_at < valid_to)",
      "cardinality": "many_to_zero_or_one"
    },
    {
      "id": "banquet_booking_to_member_event_time_v2",
      "left": "banquet.bookings",
      "right": "crm.customer_map",
      "keys": ["banquet_customer_id = banquet_customer_id"],
      "temporal_predicate": "valid_from <= event_date AND (valid_to IS NULL OR event_date < valid_to)",
      "cardinality": "many_to_zero_or_one"
    },
    {
      "id": "member_revenue_preaggregate_v2",
      "left": "serving.member_daily_revenue_metrics",
      "right": "crm.member_grade_history",
      "keys": ["member_no = member_no"],
      "temporal_predicate": "valid_from <= business_date AND (valid_to IS NULL OR business_date < valid_to)",
      "cardinality": "many_to_one",
      "rule": "각 원천을 member_no와 business_date로 먼저 집계한 뒤 결합한다. 원시 fact-to-fact JOIN은 금지한다."
    },
    {
      "id": "hotel_day_preaggregate_v2",
      "left": "serving.total_operating_daily_metrics",
      "right": "reference.hotel_entities",
      "keys": ["hotel_code = hotel_code"],
      "cardinality": "many_to_one",
      "rule": "객실·식음·연회·시설을 hotel_code와 business_date로 각각 사전 집계한 뒤 결합한다."
    }
  ],
