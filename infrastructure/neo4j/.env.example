# 로컬 Neo4j 자동 projection에 필요한 변수 이름만 제공한다.
# CHANGE_ME 값은 credential source가 아니며 실행 전에 외부 값으로 교체한다.
NEO4J_COMPOSE_PROJECT_NAME=answervice-neo4j
NEO4J_PASSWORD=CHANGE_ME_Neo4jLocalPassword
NEO4J_PROJECTION_DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME_AppUser@host.docker.internal:25432/app_db
NEO4J_BIND_ADDRESS=127.0.0.1
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
