# 활성 catalog를 읽어 Neo4j에 적재하는 one-shot image다. Backend runtime image와
# dependency를 공유하지 않아 기본 서비스 크기와 시작 경로를 바꾸지 않는다.
FROM python:3.12-slim@sha256:dd29372629eeba2dd003fd9e9d35a5b8236c44727875a0364254b5127af88e65

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/app/backend \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

COPY app/backend/requirements.txt app/backend/requirements.txt
COPY app/backend/requirements-neo4j.txt app/backend/requirements-neo4j.txt
RUN pip install --disable-pip-version-check -r app/backend/requirements-neo4j.txt \
    && useradd --create-home --uid 10001 projector

ENV PYTHONPATH=/workspace:/workspace/app/backend

COPY --chown=projector:projector app/backend/app/ app/backend/app/
COPY --chown=projector:projector app/backend/scripts/sync_neo4j_projection.py app/backend/scripts/
COPY --chown=projector:projector src/ src/

WORKDIR /workspace/app/backend
USER projector

ENTRYPOINT ["python", "scripts/sync_neo4j_projection.py"]
