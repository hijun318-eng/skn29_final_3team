RAG_DB_NAME=answervice_rag
RAG_DB_USER=rag_local
RAG_DB_PASSWORD=REQUIRED
RAG_DB_PORT=55432
RAG_GATEWAY_HMAC_SECRET=REQUIRED_MINIMUM_32_CHARACTERS
RAG_MODEL_PATH=/models/Qwen3-Embedding-0.6B
RAG_DEVICE=auto
RAG_MANUALS_DIR=/data/rag/manuals
RAG_EVIDENCE_DIR=/workspace/evals/runs/rag
RAG_BACKUP_DIR=/backups/rag
RAG_SNIPPET_MAX_CHARS=1800
RAG_ANSWER_ENDPOINT=http://rag-local-answer:8001/v1/chat/completions
RAG_ANSWER_MODEL=rag-local-answer-v1
# rag-api 및 rag-e2e profile용 실행 변수
RAG_ANSWER_API_KEY=rag-local-no-secret
RAG_EMBEDDING_MODEL_DIR=Qwen3-Embedding-0.6B
RAG_MODELS_DIR=./models
RAG_API_BIND_ADDRESS=127.0.0.1
RAG_E2E_ROLE=MANAGER
RAG_E2E_QUERY=객실 운영 장애 발생 시 보고 절차를 알려줘.
RAG_E2E_TOP_K=3

RAG_DB_HOST=rag-postgres
RAG_NETWORK_NAME=answervice-network
RAG_NETWORK_EXTERNAL=false
RAG_API_PORT=18081

# OpenAI embedding provider (copy this file to .env and set the secret locally)
RAG_EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
