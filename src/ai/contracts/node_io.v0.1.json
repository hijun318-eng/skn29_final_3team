{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:answervice:ai:node-io:v0.1",
  "version": "MODEL-v1.20.0",
  "$defs": {
    "execution_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "timezone",
        "calendar_id",
        "period_start",
        "period_end_exclusive"
      ],
      "properties": {
        "as_of": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1},
        "calendar_id": {"type": "string", "minLength": 1},
        "period_start": {"type": "string", "format": "date-time"},
        "period_end_exclusive": {"type": "string", "format": "date-time"}
      }
    },
    "schema_grain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "keys"],
      "properties": {
        "kind": {"type": "string", "enum": ["row", "event", "periodic", "aggregate"]},
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "schema_column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "native_type", "nullable", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "native_type": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"},
        "role": {
          "type": "string",
          "enum": ["identifier", "dimension", "measure", "time", "attribute"]
        }
      }
    },
    "context_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urn", "fqn", "grain", "columns"],
      "properties": {
        "urn": {"type": "string", "minLength": 1},
        "fqn": {"type": "string", "minLength": 1},
        "grain": {"$ref": "#/$defs/schema_grain"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/schema_column"}
        }
      }
    },
    "qualified_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_fqn", "column"],
      "properties": {
        "asset_fqn": {"type": "string", "minLength": 1},
        "column": {"type": "string", "minLength": 1}
      }
    },
    "required_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "parameter"],
      "properties": {
        "field": {"$ref": "#/$defs/qualified_field"},
        "operator": {
          "type": "string",
          "enum": ["eq", "neq", "gt", "gte", "lt", "lte"]
        },
        "parameter": {"type": "string", "minLength": 1}
      }
    },
    "column_metric_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field"],
      "properties": {
        "kind": {"type": "string", "const": "column"},
        "field": {"$ref": "#/$defs/qualified_field"}
      }
    },
    "ratio_metric_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "numerator_metric_id", "denominator_metric_id", "zero_policy"],
      "properties": {
        "kind": {"type": "string", "const": "ratio"},
        "numerator_metric_id": {"type": "string", "minLength": 1},
        "denominator_metric_id": {"type": "string", "minLength": 1},
        "zero_policy": {"type": "string", "enum": ["null_on_zero_denominator"]}
      }
    },
    "metric_source": {
      "oneOf": [
        {"$ref": "#/$defs/column_metric_source"},
        {"$ref": "#/$defs/ratio_metric_source"}
      ]
    },
    "context_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "aggregation",
        "result_field",
        "unit",
        "time_field",
        "dimensions",
        "required_filters"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/metric_source"},
        "aggregation": {
          "type": "string",
          "enum": ["sum", "count", "count_distinct", "min", "max", "average", "none", "ratio", "exists"]
        },
        "result_field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "unit": {"type": "string", "minLength": 1},
        "time_field": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/qualified_field"}
          ]
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_field"}
        },
        "required_filters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/required_filter"}
        }
      }
    },
    "equality_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_column", "right_column"],
      "properties": {
        "left_column": {"type": "string", "minLength": 1},
        "right_column": {"type": "string", "minLength": 1}
      }
    },
    "temporal_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_field",
        "validity_asset_fqn",
        "valid_from_column",
        "valid_to_column",
        "end_exclusive"
      ],
      "properties": {
        "event_field": {"$ref": "#/$defs/qualified_field"},
        "validity_asset_fqn": {"type": "string", "minLength": 1},
        "valid_from_column": {"type": "string", "minLength": 1},
        "valid_to_column": {"type": "string", "minLength": 1},
        "end_exclusive": {"type": "boolean", "const": true}
      }
    },
    "preaggregation_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "grain", "keys"],
      "properties": {
        "required": {"type": "boolean"},
        "grain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_field"}
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_field"}
        }
      }
    },
    "context_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "left",
        "right",
        "kind",
        "cardinality",
        "equality_conditions",
        "temporal_conditions",
        "preaggregation"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "left": {"type": "string", "minLength": 1},
        "right": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["inner", "left", "right", "full"]},
        "cardinality": {
          "type": "string",
          "enum": ["one_to_one", "many_to_one", "one_to_many", "many_to_many"]
        },
        "equality_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/equality_condition"}
        },
        "temporal_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/temporal_condition"}
        },
        "preaggregation": {"$ref": "#/$defs/preaggregation_rule"}
      }
    },
    "join_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges"],
      "properties": {
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/context_join"}
        }
      }
    },
    "schema_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "assets"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "assets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/context_asset"}
        }
      }
    },
    "resolved_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "metric_ids",
        "output_metric_ids",
        "dimensions",
        "filters",
        "time_bucket",
        "result_limit"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "aggregate",
            "breakdown",
            "time_trend",
            "top_n",
            "bottom_n",
            "period_comparison"
          ]
        },
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "output_metric_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_field"}
        },
        "filters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/required_filter"}
        },
        "time_bucket": {
          "type": "string",
          "enum": ["none", "day", "week", "month", "quarter", "year"]
        },
        "result_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "time_field_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "native_type", "bucket", "timezone_mode"],
      "properties": {
        "field": {"$ref": "#/$defs/qualified_field"},
        "native_type": {"type": "string", "minLength": 1},
        "bucket": {
          "type": "string",
          "enum": ["none", "day", "week", "month", "quarter", "year"]
        },
        "timezone_mode": {"type": "string", "enum": ["preserve", "context"]}
      }
    },
    "comparison_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_parameter", "end_parameter"],
      "properties": {
        "start_parameter": {"type": "string", "minLength": 1},
        "end_parameter": {"type": "string", "minLength": 1}
      }
    },
    "time_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "calendar_id",
        "interval",
        "start_parameter",
        "end_parameter",
        "fields"
      ],
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "calendar_id": {"type": "string", "minLength": 1},
        "interval": {"type": "string", "const": "[start,end)"},
        "start_parameter": {"type": "string", "minLength": 1},
        "end_parameter": {"type": "string", "minLength": 1},
        "comparison_window": {
          "oneOf": [
            {"$ref": "#/$defs/comparison_window"},
            {"type": "null"}
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/time_field_rule"}
        }
      }
    },
    "parameter_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "scope"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["string", "boolean", "number", "date", "timestamp"]
        },
        "scope": {"type": "string", "enum": ["time", "filter", "limit"]}
      }
    },
    "parameter_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "parameters"],
      "properties": {
        "style": {"type": "string", "const": "named"},
        "parameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameter_spec"}
        }
      }
    },
    "query_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialect",
        "statement_type",
        "read_only",
        "require_limit",
        "max_limit",
        "allowed_functions",
        "allowed_catalogs"
      ],
      "properties": {
        "dialect": {"type": "string", "const": "trino"},
        "statement_type": {"type": "string", "const": "select"},
        "read_only": {"type": "boolean", "const": true},
        "require_limit": {"type": "boolean", "const": true},
        "max_limit": {"type": "integer", "minimum": 1},
        "allowed_functions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_catalogs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "shaped_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1}
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "node1_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "role_hint",
        "as_of",
        "timezone",
        "calendar_id",
        "allowed_routes",
        "business_terms"
      ],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "role_hint": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1},
        "calendar_id": {"type": "string", "minLength": 1},
        "previous_period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end_exclusive"],
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end_exclusive": {"type": "string", "format": "date-time"}
          }
        },
        "previous_result_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["analysis_operation", "dimension_count", "result_limit"],
          "properties": {
            "analysis_operation": {
              "type": "string",
              "enum": [
                "aggregate",
                "breakdown",
                "time_trend",
                "top_n",
                "bottom_n",
                "period_comparison"
              ]
            },
            "dimension_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            },
            "result_limit": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "interpretation_recheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "attempt"],
          "properties": {
            "target": {
              "type": "string",
              "enum": ["period_candidates", "analysis_operation"]
            },
            "attempt": {"type": "integer", "const": 1}
          }
        },
        "allowed_routes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "business_terms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "aliases"],
            "properties": {
              "kind": {"type": "string", "enum": ["metric", "support_metric", "dimension"]},
              "aliases": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "value_candidates": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "node1_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_question",
        "intent_candidates",
        "measurement_source_text",
        "measurement_source_texts",
        "metric_candidates",
        "metric_resolution",
        "selected_metric_id",
        "selected_metric_ids",
        "analysis_operation",
        "result_limit",
        "dimension_candidates",
        "filter_candidates",
        "period_candidates",
        "period_relationship",
        "ambiguity"
      ],
      "properties": {
        "normalized_question": {"type": "string"},
        "intent_candidates": {"type": "array", "items": {"type": "string"}},
        "measurement_source_text": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "measurement_source_texts": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "metric_candidates": {"type": "array", "items": {"type": "string"}},
        "metric_resolution": {
          "type": "string",
          "enum": ["selected", "ambiguous", "unsupported", "missing"]
        },
        "selected_metric_id": {"type": ["string", "null"], "minLength": 1},
        "selected_metric_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "analysis_operation": {
          "type": ["string", "null"],
          "enum": [
            "aggregate",
            "breakdown",
            "time_trend",
            "top_n",
            "bottom_n",
            "period_comparison",
            null
          ]
        },
        "result_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "requested_route": {
          "type": ["string", "null"],
          "enum": ["ANALYSIS", "PRESENTATION", "REPORT_ACTION", null]
        },
        "presentation_type": {
          "type": ["string", "null"],
          "enum": [
            "SUMMARY",
            "TABLE",
            "BAR",
            "LINE",
            "PIE",
            "HORIZONTAL_BAR",
            "DONUT",
            null
          ]
        },
        "is_elliptical": {"type": ["boolean", "null"]},
        "dimension_candidates": {"type": "array", "items": {"type": "string"}},
        "filter_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension_id", "value_text", "exclude"],
            "properties": {
              "dimension_id": {"type": "string", "minLength": 1},
              "value_text": {"type": "string", "minLength": 1},
              "exclude": {"type": "boolean"}
            }
          }
        },
        "period_relationship": {"type": "string", "enum": ["single", "comparison"]},
        "period_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end_exclusive", "source_text"],
            "properties": {
              "start": {"type": "string", "format": "date-time"},
              "end_exclusive": {"type": "string", "format": "date-time"},
              "source_text": {"type": "string", "minLength": 1}
            }
          }
        },
        "ambiguity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["is_ambiguous", "reasons", "clarification_question"],
          "properties": {
            "is_ambiguous": {"type": "boolean"},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "clarification_question": {"type": ["string", "null"]}
          }
        }
      }
    },
    "node2_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "normalized_question",
        "resolved_request",
        "schema_context",
        "metric_rules",
        "join_graph",
        "time_rules",
        "parameter_contract",
        "query_policy"
      ],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "normalized_question": {"type": "string", "minLength": 1},
        "resolved_request": {"$ref": "#/$defs/resolved_request"},
        "schema_context": {"$ref": "#/$defs/schema_context"},
        "metric_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/context_metric"}
        },
        "join_graph": {"$ref": "#/$defs/join_graph"},
        "time_rules": {"$ref": "#/$defs/time_rules"},
        "parameter_contract": {"$ref": "#/$defs/parameter_contract"},
        "query_policy": {"$ref": "#/$defs/query_policy"}
      }
    },
    "node2_response": {
      "oneOf": [
        {"$ref": "#/$defs/node2_sql_only_response"},
        {"$ref": "#/$defs/node2_legacy_response"}
      ]
    },
    "node2_sql_only_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sql"],
      "properties": {
        "sql": {"type": "string", "minLength": 1}
      }
    },
    "node2_legacy_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sql",
        "used_assets",
        "used_columns",
        "used_joins",
        "used_metrics"
      ],
      "properties": {
        "sql": {"type": "string", "minLength": 1},
        "used_assets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "used_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_field"}
        },
        "used_joins": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "used_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "node2_repair_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "attempt",
        "rejected_sql",
        "normalized_question",
        "resolved_request",
        "schema_context",
        "metric_rules",
        "join_graph",
        "time_rules",
        "parameter_contract",
        "query_policy",
        "normalized_error_code",
        "repair_scope"
      ],
      "properties": {
        "trace_id": {"type": "string"},
        "attempt": {"type": "integer", "const": 1},
        "rejected_sql": {"type": "string", "minLength": 1},
        "normalized_question": {"type": "string", "minLength": 1},
        "resolved_request": {"$ref": "#/$defs/resolved_request"},
        "schema_context": {"$ref": "#/$defs/schema_context"},
        "metric_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/context_metric"}
        },
        "join_graph": {"$ref": "#/$defs/join_graph"},
        "time_rules": {"$ref": "#/$defs/time_rules"},
        "parameter_contract": {"$ref": "#/$defs/parameter_contract"},
        "query_policy": {"$ref": "#/$defs/query_policy"},
        "normalized_error_code": {"type": "string", "minLength": 1},
        "violation_detail": {"type": "string", "minLength": 1},
        "repair_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "node2_repair_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corrected_sql"],
      "properties": {
        "corrected_sql": {"type": "string", "minLength": 1}
      }
    },
    "node3_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "g3_result",
        "shaped_result",
        "metric",
        "metric_label",
        "period",
        "filters",
        "unit",
        "sampling",
        "masking",
        "partial",
        "source_ids",
        "result_reference"
      ],
      "properties": {
        "g3_result": {"type": "string", "const": "pass"},
        "shaped_result": {"$ref": "#/$defs/shaped_result"},
        "metric": {"type": "string", "minLength": 1},
        "metric_label": {"type": "string", "minLength": 1},
        "period": {"$ref": "#/$defs/execution_time"},
        "filters": {"type": "array", "items": {"type": "string"}},
        "unit": {"type": "string"},
        "sampling": {"type": "boolean"},
        "masking": {"type": "boolean"},
        "partial": {"type": "boolean"},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "metric_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_metric_id", "context_metric_ids", "entitled_metric_ids"],
          "properties": {
            "selected_metric_id": {"type": "string", "minLength": 1},
            "context_metric_ids": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "entitled_metric_ids": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "result_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"type": "string", "enum": ["query_execution_id", "result_cache_key"]},
            "value": {"type": "string"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_ids": {"minItems": 2}
            }
          },
          "then": {
            "required": ["metric_selection"]
          }
        }
      ]
    },
    "node3_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanation", "conditions", "sources", "limitations"],
      "properties": {
        "explanation": {"type": "string"},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "report_assistant_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "query_id",
        "title",
        "narrative",
        "evidence",
        "chart_spec",
        "checksum"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "narrative": {"type": "string"},
        "evidence": {"type": "object"},
        "chart_spec": {"type": ["object", "null"]},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "report_assistant_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "artifact"],
      "properties": {
        "instruction": {"type": "string", "minLength": 1, "maxLength": 500},
        "artifact": {"$ref": "#/$defs/report_assistant_artifact"}
      }
    },
    "report_assistant_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "executive_summary", "table_title", "chart_title"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "executive_summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "table_title": {"type": "string", "minLength": 1, "maxLength": 255},
        "chart_title": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    }
  }
}
