      "time_field": "business_date",
      "required_filters": [
        {"field": "data_period_status", "operator": "eq", "value_type": "string", "value": "SYNTHETIC_ACTUAL_LIKE"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
