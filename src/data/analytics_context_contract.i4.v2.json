{
  "contract_version": "I4-CONTEXT-v2.3.0-DRAFT",
  "metric_registry_version": "I4-METRIC-v1.3.0-DRAFT",
  "context_source": "LIVE_DATAHUB",
  "synthetic": true,
  "required_filter_contract": {
    "fields": ["field", "operator", "value_type", "value"],
    "value_types": ["string", "boolean", "number", "date"],
    "date_format": "YYYY-MM-DD",
    "number_policy": "finite_non_boolean",
    "parameter_order": ["period_start", "period_end_exclusive", "required_filter_N"]
  },
  "view_contract": "src/data/serving_analytics_contract.i4.v1.json",
  "selection_policy": {
    "default": "serving_views",
    "raw_allowed_for": ["crm_only", "approved_pms_crm_join"],
    "max_datasets": 8,
    "max_columns": 60
  },
  "metrics": [
    {
      "id": "recognized_room_revenue",
      "asset_fqn": "serving.analytics.hotel_daily_metrics",
      "field": "room_revenue",
      "aggregation": "sum",
      "time_field": "business_date",
      "required_filters": [
        {"field": "data_period_status", "operator": "eq", "value_type": "string", "value": "ACTUAL"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "fnb_net_revenue",
      "asset_fqn": "serving.analytics.fnb_daypart_metrics",
      "field": "fnb_net_revenue",
      "aggregation": "sum",
      "time_field": "business_date",
      "required_filters": [
        {"field": "data_period_status", "operator": "eq", "value_type": "string", "value": "ACTUAL"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "facility_revenue",
      "asset_fqn": "serving.analytics.facility_daily_metrics",
      "field": "facility_revenue",
      "aggregation": "sum",
      "time_field": "business_date",
      "required_filters": [
        {"field": "data_period_status", "operator": "eq", "value_type": "string", "value": "ACTUAL"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "actual_attendees",
      "asset_fqn": "serving.analytics.banquet_monthly_metrics",
      "field": "actual_attendees",
      "aggregation": "sum",
      "time_field": "year_month",
      "required_filters": [
        {"field": "data_period_status", "operator": "eq", "value_type": "string", "value": "ACTUAL"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "expired_points",
      "asset_fqn": "crm.dbo.crm_point_transactions",
      "field": "points_delta",
      "aggregation": "negative_sum",
      "time_field": "event_at",
      "required_filters": [
        {"field": "txn_type", "operator": "eq", "value_type": "string", "value": "EXPIRE"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "earned_points",
      "asset_fqn": "crm.dbo.crm_point_transactions",
      "field": "points_delta",
      "aggregation": "sum",
      "time_field": "event_at",
      "required_filters": [
        {"field": "txn_type", "operator": "eq", "value_type": "string", "value": "EARN"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "redeemed_points",
      "asset_fqn": "crm.dbo.crm_point_transactions",
      "field": "points_delta",
      "aggregation": "negative_sum",
      "time_field": "event_at",
      "required_filters": [
        {"field": "txn_type", "operator": "eq", "value_type": "string", "value": "USE"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "current_points_balance_sum",
      "asset_fqn": "crm.dbo.crm_members",
      "field": "points_balance",
      "aggregation": "sum",
      "time_field": "joined_at",
      "temporal_semantics": "current_snapshot",
      "required_filters": [
        {"field": "member_status", "operator": "eq", "value_type": "string", "value": "ACTIVE"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    },
    {
      "id": "current_points_balance_average",
      "asset_fqn": "crm.dbo.crm_members",
      "field": "points_balance",
      "aggregation": "avg",
      "time_field": "joined_at",
      "temporal_semantics": "current_snapshot",
      "required_filters": [
        {"field": "member_status", "operator": "eq", "value_type": "string", "value": "ACTIVE"},
        {"field": "is_forecast", "operator": "eq", "value_type": "boolean", "value": false}
      ]
    }
  ],
  "dimensions": [
    {
      "id": "month",
      "asset_fqn": "serving.analytics.hotel_daily_metrics",
      "field": "business_date",
      "aliases": ["월별", "월간", "month"]
    },
    {
      "id": "membership_grade",
      "asset_fqn": "crm.dbo.crm_members",
      "field": "membership_grade",
      "aliases": ["회원 등급별", "멤버십 등급별", "등급별"]
    }
  ],
  "raw_assets": [
    {
      "fqn": "crm.dbo.crm_members",
      "urn": "urn:li:dataset:(urn:li:dataPlatform:mssql,crm.crm_db.dbo.crm_members,PROD)",
      "uses": ["crm_only"],
      "columns": ["property_id", "member_no", "membership_grade", "points_balance", "joined_at", "member_status", "is_forecast"]
    },
    {
      "fqn": "crm.dbo.crm_member_grade_history",
      "urn": "urn:li:dataset:(urn:li:dataPlatform:mssql,crm.crm_db.dbo.crm_member_grade_history,PROD)",
      "uses": ["crm_only", "approved_pms_crm_join"],
      "columns": ["property_id", "member_no", "grade_code", "valid_from", "valid_to", "change_reason_code"]
    },
    {
      "fqn": "crm.dbo.crm_point_transactions",
      "urn": "urn:li:dataset:(urn:li:dataPlatform:mssql,crm.crm_db.dbo.crm_point_transactions,PROD)",
      "uses": ["crm_only"],
      "columns": ["property_id", "member_no", "event_at", "txn_type", "points_delta", "related_source", "is_forecast"]
    },
    {
      "fqn": "pms.public.pms_stays",
      "urn": "urn:li:dataset:(urn:li:dataPlatform:postgres,pms.pms_db.public.pms_stays,PROD)",
      "uses": ["approved_pms_crm_join"],
      "columns": ["property_id", "stay_id", "reservation_id", "actual_checkout_at", "occupied_room_nights", "room_revenue", "stay_status", "complimentary_flag", "house_use_flag", "is_forecast"]
    },
    {
      "fqn": "pms.public.pms_reservations",
      "urn": "urn:li:dataset:(urn:li:dataPlatform:postgres,pms.pms_db.public.pms_reservations,PROD)",
      "uses": ["approved_pms_crm_join"],
      "columns": ["property_id", "reservation_id", "guest_id"]
    },
    {
      "fqn": "pms.public.pms_guests",
      "urn": "urn:li:dataset:(urn:li:dataPlatform:postgres,pms.pms_db.public.pms_guests,PROD)",
      "uses": ["approved_pms_crm_join"],
      "columns": ["property_id", "guest_id"]
    },
    {
      "fqn": "crm.dbo.crm_customer_map",
      "urn": "urn:li:dataset:(urn:li:dataPlatform:mssql,crm.crm_db.dbo.crm_customer_map,PROD)",
      "uses": ["approved_pms_crm_join"],
      "columns": ["property_id", "pms_guest_id", "member_no", "valid_from", "valid_to"]
    }
  ],
  "approved_joins": [
    {
      "id": "crm_point_transactions_to_members_v1",
      "assets": [
        "crm.dbo.crm_point_transactions",
        "crm.dbo.crm_members"
      ],
      "event_time_field": "crm.dbo.crm_point_transactions.event_at",
      "cardinality": "many_to_one",
      "join_edges": [
        {
          "left": "crm.dbo.crm_point_transactions",
          "right": "crm.dbo.crm_members",
          "on_predicates": [
            "crm.dbo.crm_point_transactions.property_id = crm.dbo.crm_members.property_id",
            "crm.dbo.crm_point_transactions.member_no = crm.dbo.crm_members.member_no"
          ]
        }
      ]
    },
    {
      "id": "pms_stay_to_crm_membership_grade_event_time_v1",
      "assets": [
        "pms.public.pms_stays",
        "pms.public.pms_reservations",
        "pms.public.pms_guests",
        "crm.dbo.crm_customer_map",
        "crm.dbo.crm_member_grade_history"
      ],
      "event_time_field": "pms.public.pms_stays.actual_checkout_at",
      "cardinality": "many_to_zero_or_one",
      "join_edges": [
        {
          "left": "pms.public.pms_stays",
          "right": "pms.public.pms_reservations",
          "on_predicates": [
            "pms.public.pms_stays.property_id = pms.public.pms_reservations.property_id",
            "pms.public.pms_stays.reservation_id = pms.public.pms_reservations.reservation_id"
          ]
        },
        {
          "left": "pms.public.pms_reservations",
          "right": "pms.public.pms_guests",
          "on_predicates": [
            "pms.public.pms_reservations.property_id = pms.public.pms_guests.property_id",
            "pms.public.pms_reservations.guest_id = pms.public.pms_guests.guest_id"
          ]
        },
        {
          "left": "pms.public.pms_guests",
          "right": "crm.dbo.crm_customer_map",
          "on_predicates": [
            "pms.public.pms_guests.property_id = crm.dbo.crm_customer_map.property_id",
            "pms.public.pms_guests.guest_id = crm.dbo.crm_customer_map.pms_guest_id",
            "crm.dbo.crm_customer_map.valid_from <= pms.public.pms_stays.actual_checkout_at",
            "crm.dbo.crm_customer_map.valid_to IS NULL OR pms.public.pms_stays.actual_checkout_at < crm.dbo.crm_customer_map.valid_to"
          ]
        },
        {
          "left": "crm.dbo.crm_customer_map",
          "right": "crm.dbo.crm_member_grade_history",
          "on_predicates": [
            "crm.dbo.crm_customer_map.property_id = crm.dbo.crm_member_grade_history.property_id",
            "crm.dbo.crm_customer_map.member_no = crm.dbo.crm_member_grade_history.member_no",
            "crm.dbo.crm_member_grade_history.valid_from <= pms.public.pms_stays.actual_checkout_at",
            "crm.dbo.crm_member_grade_history.valid_to IS NULL OR pms.public.pms_stays.actual_checkout_at < crm.dbo.crm_member_grade_history.valid_to"
          ]
        }
      ]
    }
  ]
}
